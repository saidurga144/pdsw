# ==============================================================================
# PDSW Environment Configuration (MetaMask SIWE Cryptographic Identity)
# ==============================================================================

# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api

# Blockchain & MetaMask Authentication
# 11155111 = Sepolia Testnet, 1 = Ethereum Mainnet, 31337 = Hardhat Localhost
NEXT_PUBLIC_CHAIN_ID=11155111

# Authentication & Session Security
JWT_SECRET=replace-with-a-random-jwt-secret-at-least-32-characters
JWT_EXPIRES_IN=8h

# IPFS & Cryptographic Anchoring
# Server-side Pinata service origin (local development). In Netlify, set
# PINATA_SERVICE_URL in the UI/API with Builds and Functions scopes to the
# deployed Render service origin, e.g. https://pdsw-pinata.onrender.com.
# Do not include /api/ipfs/upload in the value and do not use NEXT_PUBLIC_.
PINATA_SERVICE_URL=http://localhost:5001
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8080
IPFS_PROJECT_ID=replace-with-your-ipfs-project-id
IPFS_PROJECT_SECRET=replace-with-your-ipfs-project-secret
SHA256_INTEGRITY_SALT=replace-with-your-sha256-integrity-salt
INTEGRITY_SALT=replace-with-your-integrity-salt

# Google Tink AEAD Authenticated Encryption & Key Management
TINK_MASTER_KEY=replace-with-a-separate-random-tink-master-key-at-least-32-characters
