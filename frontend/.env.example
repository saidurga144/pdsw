# ==============================================================================
# PDSW Environment Configuration (MetaMask SIWE Cryptographic Identity)
# ==============================================================================

# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api

# Blockchain & MetaMask Authentication
# 11155111 = Sepolia Testnet, 1 = Ethereum Mainnet, 31337 = Hardhat Localhost
NEXT_PUBLIC_CHAIN_ID=11155111

# Authentication & Session Security
JWT_SECRET=pdsw-super-secret-cryptographic-jwt-key-2026-production-ready
JWT_EXPIRES_IN=8h

# IPFS & Cryptographic Anchoring
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8080
IPFS_PROJECT_ID=pdsw-ipfs-node-primary
IPFS_PROJECT_SECRET=pdsw-ipfs-secret-token-2026
SHA256_INTEGRITY_SALT=pdsw-immutable-state-salt-2026
INTEGRITY_SALT=pdsw-immutable-state-salt-2026

# Google Tink AEAD Authenticated Encryption & Key Management
TINK_MASTER_KEY=pdsw-tink-master-aead-secret-2026-production-key-seed
