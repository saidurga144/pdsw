# ==============================================================================
# Pinata IPFS Service Configuration Template
# ==============================================================================
PORT=5001

# Allowed Origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Pinata API Credentials (Keep strictly on server-side!)
# Option A: Pinata JWT Bearer Token (Recommended)
PINATA_JWT=

# Option B: Pinata API Key & Secret
PINATA_API_KEY=
PINATA_API_SECRET=

# Public or Dedicated Gateway
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Maximum file upload size in MB (Default: 15)
MAX_FILE_SIZE_MB=15
