# ==============================================================================
# PDSW FastAPI Backend Environment Configuration – EXAMPLE / TEMPLATE
# Copy this file to .env and fill in real values. Never commit .env.
# ==============================================================================

# Database Configuration (SQLite Async – local dev)
DATABASE_URL=sqlite+aiosqlite:///./pdsw_local.db

# ── MongoDB Configuration (User Signup / Login) ──────────────────────────────
# Atlas (cloud) connection string – obtain from Atlas > Connect > Drivers.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
# Name of the MongoDB database to use (created automatically if absent).
MONGODB_DATABASE=pdsw

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Blockchain Network ────────────────────────────────────────────────────────
SEPOLIA_CHAIN_ID=11155111

# ── First-Admin Bootstrap (one-time setup token) ──────────────────────────────
BOOTSTRAP_ADMIN_SECRET=pdsw-bootstrap-secret-change-me-2026
